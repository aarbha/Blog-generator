# Ollama — download models:  ollama pull qwen2.5:7b  &&  ollama pull qwen2.5:3b  &&  ollama pull qwen2.5:1.5b
# CPU tip: set OMP_NUM_THREADS to half your CPU cores to manage heat, e.g.:
#   set OMP_NUM_THREADS=4   (Windows)
#   export OMP_NUM_THREADS=4  (Linux/Mac)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_WRITER=qwen2.5:7b
OLLAMA_MODEL_ANALYZER=qwen2.5:3b
OLLAMA_MODEL_CHEAP=qwen2.5:1.5b
OLLAMA_TIMEOUT_WRITER=300
OLLAMA_TIMEOUT_ANALYZER=180
OLLAMA_TIMEOUT_CHEAP=120

# Medium integration token (optional) — get from Medium → Settings → Security → Integration tokens
MEDIUM_TOKEN=
